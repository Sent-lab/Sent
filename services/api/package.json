{
  "name": "@sent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP API. Serves projections and SDK-built intents; never re-derives economics.",
  "exports": {
    ".": "./src/server.ts",
    "./handlers": "./src/handlers.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types sim/handlers.ts",
    "start": "node --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "viem": "^2.56.3",
    "@sent/realtime": "workspace:*",
    "@sent/sdk": "workspace:*",
    "@sent/economics": "workspace:*",
    "@sent/database": "workspace:*",
    "@sent/contracts": "workspace:*",
    "@sent/config": "workspace:*",
    "@sent/observability": "workspace:*"
  }
}
