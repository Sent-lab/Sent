{
  "name": "sent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SENT - xStock Launchpad on HyperEVM",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "sim": "node --experimental-strip-types packages/economics/sim/reference.ts",
    "sim:v3": "node --experimental-strip-types packages/economics/sim/graduation-v3.ts",
    "sim:stockback": "node --experimental-strip-types packages/stockback/sim/stockback.ts",
    "sim:all": "pnpm sim && pnpm sim:v3 && pnpm sim:stockback && pnpm sim:twab-edges && pnpm sim:lifecycle && pnpm sim:reorg && pnpm sim:freshness && pnpm sim:determinism && pnpm sim:gateway && pnpm sim:api && pnpm sim:finalizer && pnpm sim:worker && pnpm sim:config && pnpm sim:format && pnpm sim:chart && pnpm sim:approve && pnpm sim:claim && pnpm sim:observability && pnpm sim:cache && pnpm sim:tx",
    "fixtures": "node --experimental-strip-types packages/economics/sim/fixtures.ts",
    "fixtures:merkle": "node --experimental-strip-types packages/stockback/sim/merkle-fixtures.ts",
    "fixtures:all": "pnpm fixtures && pnpm fixtures:merkle && pnpm fixtures:intent && pnpm fixtures:v3",
    "sim:lifecycle": "node --experimental-strip-types packages/economics/sim/lifecycle.ts",
    "sim:twab-edges": "node --experimental-strip-types packages/stockback/sim/twab-edges.ts",
    "abis": "node --experimental-strip-types packages/contracts/scripts/export-abis.ts",
    "fixtures:intent": "node --experimental-strip-types packages/sdk/sim/intent-fixtures.ts",
    "sim:reorg": "node --experimental-strip-types services/indexer/sim/reorg.ts",
    "sim:projection": "node --experimental-strip-types services/indexer/sim/projection.ts",
    "sim:freshness": "node --experimental-strip-types packages/realtime/sim/freshness.ts",
    "sim:determinism": "node --experimental-strip-types services/stockback/sim/determinism.ts",
    "sim:gateway": "node --experimental-strip-types services/realtime/sim/gateway.ts",
    "sim:api": "node --experimental-strip-types services/api/sim/handlers.ts",
    "fixtures:v3": "node --experimental-strip-types packages/economics/sim/v3-fixtures.ts",
    "sim:finalizer": "node --experimental-strip-types services/finalizer/sim/finalizer.ts",
    "sim:worker": "node --experimental-strip-types services/worker/sim/worker.ts",
    "sim:config": "node --experimental-strip-types packages/config/sim/env.ts",
    "migrate": "node --experimental-strip-types infra/migrations/run.ts",
    "migrate:status": "node --experimental-strip-types infra/migrations/run.ts --status",
    "sim:format": "node --experimental-strip-types apps/web/sim/format.ts",
    "sim:chart": "node --experimental-strip-types apps/web/sim/chart.ts",
    "sim:approve": "node --experimental-strip-types packages/sdk/sim/approve.ts",
    "sim:claim": "node --experimental-strip-types packages/sdk/sim/claim.ts",
    "sim:cache": "node --experimental-strip-types services/api/sim/cache.ts",
    "sim:observability": "node --experimental-strip-types packages/observability/sim/observability.ts",
    "sim:tx": "node --experimental-strip-types apps/web/sim/tx.ts",
    "e2e": "node --experimental-strip-types tests/e2e/stack.ts",
    "load": "node --experimental-strip-types tests/load/scale.ts",
    "concurrency": "node --experimental-strip-types tests/load/concurrency.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "viem": "^2.56.3",
    "ws": "^8.21.3"
  }
}
