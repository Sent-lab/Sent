# SENT low-cost public beta deployment template.
# Copy this file to a host-only path and fill it there. Do not commit real values.

POSTGRES_PASSWORD=replace-with-64-lowercase-hex-characters

# Select a provider with archive access and a documented quota for API + indexer.
# Hyperliquid's public endpoint has 50-block eth_getLogs queries and 100 RPC req/min/IP.
RPC_URL=
CHAIN_ID=999
FACTORY_ADDRESS=
REWARD_VAULT_ADDRESS=
START_BLOCK=
CONFIRMATIONS=20

WEB_DOMAIN=sent.example.com
API_DOMAIN=api.sent.example.com
REALTIME_DOMAIN=stream.sent.example.com
SENT_IMAGE_TAG=local

# Leave empty. The keeper is excluded from the default public-beta stack.
KEEPER_PRIVATE_KEY=
