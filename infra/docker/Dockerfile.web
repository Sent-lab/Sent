# SENT — production Next.js image, separate from the API/worker runtime.
#
# NEXT_PUBLIC_* values are build-time values in Next.js. The production compose
# file passes the public HTTPS/WSS origins as build args; no secrets belong here.

FROM node:22-alpine AS build

RUN corepack enable
WORKDIR /app

# Copy every workspace manifest first. Source edits then reuse the dependency
# layer during image rebuilds, which matters on a small ARM beta host. Keep this
# list aligned with pnpm-workspace.yaml when adding or removing workspaces.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/database/package.json packages/database/
COPY packages/economics/package.json packages/economics/
COPY packages/observability/package.json packages/observability/
COPY packages/realtime/package.json packages/realtime/
COPY packages/sdk/package.json packages/sdk/
COPY packages/stockback/package.json packages/stockback/
COPY services/api/package.json services/api/
COPY services/finalizer/package.json services/finalizer/
COPY services/indexer/package.json services/indexer/
COPY services/keeper/package.json services/keeper/
COPY services/realtime/package.json services/realtime/
COPY services/stockback/package.json services/stockback/
COPY services/worker/package.json services/worker/
COPY infra/package.json infra/
COPY tests/e2e/package.json tests/e2e/
COPY tests/integration/package.json tests/integration/
COPY tests/load/package.json tests/load/
RUN pnpm install --frozen-lockfile

COPY . .

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_REALTIME_URL
ARG NEXT_PUBLIC_CHAIN_ID=999
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_REALTIME_URL=${NEXT_PUBLIC_REALTIME_URL}
ENV NEXT_PUBLIC_CHAIN_ID=${NEXT_PUBLIC_CHAIN_ID}

RUN mkdir -p /app/apps/web/public \
    && pnpm --filter @sent/web build

FROM node:22-alpine AS runtime

ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /app

COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public

USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/healthz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["node", "apps/web/server.js"]
